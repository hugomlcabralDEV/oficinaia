# 1) Copie este arquivo para ".env"   (cp .env.example .env)
# 2) Cole sua chave gerada em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelo usado em toda a oficina. Se der erro de cota, troque por gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Interface web (módulo 5)
AGENTE_NOME=Guia Rec'n'Play
MAX_MENSAGENS_POR_SESSAO=40
